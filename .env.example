# Copy to .env.local and fill in per environment.

# Base URL of your backend API (used by src/lib/config/axios.ts)
EXPO_PUBLIC_API_BASE_URL=

# Sentry DSN — leave empty in development (Sentry only sends in preview/production)
EXPO_PUBLIC_SENTRY_DSN=

# Show the light/dark theme switch. Set to "false" to hide it and lock the theme.
EXPO_PUBLIC_ENABLE_THEME_SWITCH=true
